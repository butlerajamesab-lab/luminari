{
  "include": [
    "server/akb-lookup.ts",
    "server/autonomous-healer.ts",
    "server/batch-rerun.ts",
    "server/benefits-discovery.ts",
    "server/benefits-navigator.ts",
    "server/benefits-state-overlays.ts",
    "server/bundle-download-route.ts",
    "server/bundle-generator.ts",
    "server/bundle-sync.ts",
    "server/campaign-engine-service.ts",
    "server/case-pattern-bridge.ts",
    "server/case-to-pattern-pipeline.ts",
    "server/category-data.ts",
    "server/cda-bundle-zip.ts",
    "server/cda-bundle.ts",
    "server/cda-db.ts",
    "server/cda-end-condition.ts",
    "server/cda-export-route.ts",
    "server/cda-orchestrator.ts",
    "server/cda-patterns.ts",
    "server/cda-pipeline.ts",
    "server/chain-verification-cron.ts",
    "server/civic-map.ts",
    "server/civil-gideon.ts",
    "server/claim-backfill.ts",
    "server/claim-to-remedy-pipeline.ts",
    "drizzle/schema.ts",
    "server/db.ts",
    "server/routers.ts"
  ],
  "exclude": [
    "node_modules",
    "build",
    "dist",
    "**/*.test.ts",
    "client/**/*"
  ],
  "compilerOptions": {
    "incremental": false,
    "tsBuildInfoFile": "./node_modules/typescript/tsbuildinfo",
    "noEmit": true,
    "module": "ESNext",
    "strict": true,
    "target": "ES2020",
    "downlevelIteration": true,
    "lib": [
      "esnext",
      "dom",
      "dom.iterable"
    ],
    "jsx": "preserve",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "types": [
      "node",
      "vite/client"
    ],
    "paths": {
      "@/*": [
        "./client/src/*"
      ],
      "@shared/*": [
        "./shared/*"
      ]
    }
  }
}
