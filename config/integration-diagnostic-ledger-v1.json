{
  "schema_version": "1.0.0",
  "ledger_id": "integration_diagnostic_ledger_v1",
  "reference_issue": "#383",
  "constitutional_boundary": {
    "atlas": "creates and populates source/candidate/canonical substrate",
    "lighthouse": "observes, reflects, governs, and never invents a second canonical state",
    "runtime_rule": "a zero-count surface is not evidence of an empty substrate when authoritative source-backed views remain populated"
  },
  "semantic_layers": [
    {
      "kind": "source_record",
      "description": "Source-bound authored material or row payloads; not yet observations, candidates, or canonical objects."
    },
    {
      "kind": "observation",
      "description": "A read-model or view row observed from the current substrate; may still be unpublished or compatibility-backed."
    },
    {
      "kind": "candidate",
      "description": "Typed corpus candidate retained for reconciliation and publication gating; not a finding, signal, or public object."
    },
    {
      "kind": "signal",
      "description": "A signal remains a signal even when case-linked; it is not upgraded to convergence or finding by display code."
    },
    {
      "kind": "convergence",
      "description": "Convergences require their own canonical contract and are never inferred from mere co-display."
    },
    {
      "kind": "finding",
      "description": "Findings are downstream adjudicative outputs and must never be invented by diagnostic or explorer pull-through."
    }
  ],
  "source_families": [
    {
      "family_key": "legal",
      "label": "Legal authority catalog",
      "canonical_objects": [
        "legal_authority",
        "statute",
        "case_law"
      ],
      "relations": [
        {
          "relation": "public.v_lighthouse_legal_authority_catalog_v2",
          "role": "authoritative_view"
        },
        {
          "relation": "public.luminari_corpus_candidate_v1",
          "role": "candidate_substrate"
        },
        {
          "relation": "public.legal_statutes",
          "role": "legacy_compat_table"
        },
        {
          "relation": "public.legal_case_law",
          "role": "legacy_compat_table"
        }
      ],
      "runtime_surfaces": [
        {
          "surface": "/legal-library",
          "query": "trpc.canonicalCore.legalAuthorities + legalLibrary typed/compatibility readers"
        },
        {
          "surface": "/mission-control",
          "query": "trpc.canonicalCore.legalAuthorities"
        }
      ]
    },
    {
      "family_key": "resources",
      "label": "Resource and program directory",
      "canonical_objects": [
        "resource",
        "program"
      ],
      "relations": [
        {
          "relation": "public.v_lighthouse_resource_program_catalog_v2",
          "role": "authoritative_view"
        },
        {
          "relation": "public.luminari_corpus_candidate_v1",
          "role": "candidate_substrate"
        },
        {
          "relation": "public.case_resource_links",
          "role": "case_edge"
        }
      ],
      "runtime_surfaces": [
        {
          "surface": "/resources",
          "query": "trpc.resourceDirectory.search/detail"
        },
        {
          "surface": "/civic-map",
          "query": "REST civic-map coverage/detail"
        }
      ]
    },
    {
      "family_key": "workflows",
      "label": "Workflow and accountability substrate",
      "canonical_objects": [
        "workflow",
        "deadline",
        "enforcement_pathway",
        "oversight_route"
      ],
      "relations": [
        {
          "relation": "public.v_lighthouse_workflow_accountability_catalog_v1",
          "role": "authoritative_view"
        },
        {
          "relation": "public.registry_deadline_rules",
          "role": "canonical_table"
        },
        {
          "relation": "public.luminari_corpus_candidate_v1",
          "role": "candidate_substrate"
        }
      ],
      "runtime_surfaces": [
        {
          "surface": "case_action_context",
          "query": "sealed intake action-path receipts; load_governed_legal_registry declared jurisdiction/claim candidates; jurisdiction-scoped enforcement references"
        }
      ]
    },
    {
      "family_key": "signals",
      "label": "Signal substrate",
      "canonical_objects": [
        "signal",
        "pattern_signal",
        "intake_signal"
      ],
      "relations": [
        {
          "relation": "public.intake_signals",
          "role": "domain_1"
        },
        {
          "relation": "public.legal_patterns",
          "role": "domain_2"
        },
        {
          "relation": "public.live_data_signals",
          "role": "domain_3"
        },
        {
          "relation": "public.signal_convergences",
          "role": "explicit_convergence"
        },
        {
          "relation": "public.signal_artifact_case_links_v1",
          "role": "case_edge"
        }
      ],
      "runtime_surfaces": [
        {
          "surface": "/signal-registry",
          "query": "trpc.signalExtraction.* / trpc.enforcementIntel.list_case_signal_artifacts"
        },
        {
          "surface": "case_action_context",
          "query": "signal_artifact_case_links_v1 exact case bindings"
        }
      ]
    },
    {
      "family_key": "doctrine_weak_joints",
      "label": "Doctrine, contradictions, and weak joints",
      "canonical_objects": [
        "contradiction",
        "weak_joint",
        "doctrine"
      ],
      "relations": [
        {
          "relation": "public.legal_weak_joints",
          "role": "canonical_table"
        },
        {
          "relation": "public.legal_contradictions",
          "role": "canonical_table"
        },
        {
          "relation": "public.doctrine_graph_edges",
          "role": "graph_relation"
        }
      ],
      "runtime_surfaces": [
        {
          "surface": "/legal-library",
          "query": "trpc.legalLibrary.searchWeakJoints/listContradictions"
        },
        {
          "surface": "/doctrine-graph",
          "query": "trpc.enforcementIntel.getDoctrineGraph"
        }
      ]
    },
    {
      "family_key": "intake_case_links",
      "label": "Intake and case attachment substrate",
      "canonical_objects": [
        "case_instance",
        "case_resource_link",
        "signal_case_link"
      ],
      "relations": [
        {
          "relation": "public.v_lighthouse_case_attachable_objects_v1",
          "role": "authoritative_view"
        },
        {
          "relation": "public.case_resource_links",
          "role": "case_edge"
        },
        {
          "relation": "public.signal_artifact_case_links_v1",
          "role": "case_edge"
        }
      ],
      "runtime_surfaces": [
        {
          "surface": "trpc.luminari.get_action_context (public.cases namespace)",
          "query": "service-layer case action context"
        },
        {
          "surface": "trpc.case_state.get",
          "query": "case_state resource links"
        }
      ]
    }
  ],
  "graph_edges": [
    {
      "edge_key": "civic_relationship_graph",
      "relation": "public.v_lighthouse_graph_edges_v2",
      "description": "Current structural plus explicit semantic civic relationship graph."
    },
    {
      "edge_key": "case_resource_links",
      "relation": "public.case_resource_links",
      "description": "Reviewer-authored case-to-resource links."
    },
    {
      "edge_key": "signal_case_links",
      "relation": "public.signal_artifact_case_links_v1",
      "description": "Case bindings for signal artifacts without inventing findings."
    }
  ]
}
