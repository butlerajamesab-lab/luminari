{
  "$id": "stream.json",
  "type": "object",
  "required": [
    "stream_id",
    "source_id",
    "jurisdiction_id",
    "module_hint",
    "throughput_profile",
    "safety_profile",
    "governance_contract_id",
    "status",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "stream_id": { "type": "string" },
    "source_id": { "type": "string" },
    "jurisdiction_id": { "type": "string" },
    "module_hint": { "type": "string" },
    "throughput_profile": {
      "type": "string",
      "enum": ["low", "medium", "high", "ultra"]
    },
    "safety_profile": {
      "type": "string",
      "enum": ["default", "restricted", "critical"]
    },
    "governance_contract_id": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["active", "degraded", "quarantined", "paused"]
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  }
}
