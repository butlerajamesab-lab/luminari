  "icwa_activation_rules": [
    {
      "rule_id": "ca_icwa_child_welfare",
      "trigger_pipeline": "child_welfare",
      "activation_condition": "tribal_affiliation_declared",
      "activation_steps": [
        "Apply federal ICWA (25 USC \u00a71901) and CA state ICWA (AB 3176 / WIC \u00a7224) standards",
        "CA ICWA requires 'active efforts' (higher than 'reasonable efforts') to prevent removal",
        "Contact CILS (800-743-8941) for ICWA legal representation",
        "Notify specific tribal ICWA office if tribe identified",
        "If tribe unknown, contact SCTCA or CILS for tribal identification assistance",
        "Qualified expert witness required for foster care placement or TPR"
      ],
      "routing_entities": [
        "ca_cils",
        "ca_sctca",
        "ca_yurok",
        "ca_hoopa"
      ]
    },
    {
      "rule_id": "ca_icwa_custody",
      "trigger_pipeline": "custody_dispute",
      "activation_condition": "tribal_affiliation_declared",
      "activation_steps": [
        "Determine if ICWA applies to custody proceeding",
        "Contact CILS for tribal family law representation",
        "Verify tribal membership or eligibility for membership",
        "Ensure tribal court jurisdiction is considered"
      ],
      "routing_entities": [
        "ca_cils"
      ]
    },
    {
      "rule_id": "ca_tribal_tanf_benefits",
      "trigger_pipeline": "benefits_denial",
      "activation_condition": "tribal_affiliation_declared",
      "activation_steps": [
        "Check eligibility for CA Tribal TANF (operated by SCTCA and other tribal organizations)",
        "Tribal TANF may have different eligibility rules than CalWORKs",
        "Contact SCTCA (760-742-8600) for Southern CA tribal TANF",
        "Contact specific tribal social services for reservation-based TANF"
      ],
      "routing_entities": [
        "ca_sctca",
        "ca_cils"
      ]
    }
