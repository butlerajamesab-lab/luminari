      "title": "Wage Theft",
      "steps": [
        {
          "step": 1,
          "action": "Document wages owed",
          "contact": "Personal records",
          "deadline": "2-year SOL"
        },
        {
          "step": 2,
          "action": "File Arkansas DOL",
          "contact": "AR DOL: 501-682-4500",
          "deadline": "2-year SOL"
        },
        {
          "step": 3,
          "action": "File federal WHD simultaneously",
          "contact": "WHD Little Rock: 501-324-5292 · dol.gov/whd",
          "deadline": "2-year SOL (3 if willful) — FATAL"
        }
      ],
      "statutes": "Arkansas minimum wage $11.00/hr; FLSA 29 USC §201"
    },
