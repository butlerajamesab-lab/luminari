      "trigger_pipeline": "insurance_claim_denial",
      "activation_condition": "tribal_affiliation_declared",
      "activation_steps": [
        "Check IHS eligibility before OHP application",
        "AI/AN members exempt from OHP cost-sharing",
        "Route to nearest tribal health program or IHS Portland Area",
        "Contact NARA NW (503-230-9875) for Portland metro"
      ],
      "routing_entities": [
        "or_ihs_portland",
        "or_nara_nw"
      ]
    },
    {
      "rule_id": "or_tribal_tanf",
