      "activation_condition": "tribal_affiliation_declared",
      "activation_steps": [
        "Check tribal TANF eligibility (separate from state TANF)",
        "Warm Springs, Umatilla, Grand Ronde, Klamath operate tribal TANF",
        "Tribal TANF may have different time limits and work requirements",
        "Contact tribal social services for application"
      ],
      "routing_entities": [
        "or_warm_springs",
        "or_umatilla",
        "or_grand_ronde",
        "or_klamath"
      ]
    }
  ],
