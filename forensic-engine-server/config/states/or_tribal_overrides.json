  "tribal_context": "Oregon has 9 federally recognized tribes. ICWA applies to all child welfare cases involving AI/AN children. Oregon also has strong urban Indian programs through NAYA and NARA NW in Portland. Governor's Office of Tribal Relations coordinates state-tribal relations.",
  "icwa_activation_rules": [
    {
      "rule_id": "or_icwa_child_welfare",
      "trigger_pipeline": "child_welfare",
      "activation_condition": "tribal_affiliation_declared",
      "activation_steps": [
        "Apply federal ICWA (25 USC \u00a71901) standards",
        "Contact specific tribal ICWA office if tribe identified",
        "Contact NAPOLS (503-236-6813) for legal representation",
        "DHS must provide active efforts to prevent removal",
        "Qualified expert witness required for foster care placement or TPR"
      ],
      "routing_entities": [
        "or_warm_springs",
        "or_umatilla",
        "or_grand_ronde",
        "or_klamath",
        "or_siletz"
      ]
    },
    {
