  "interpretive_lenses": [
    {
      "lens_id": "safety_risk",
      "label": "Safety Risk Lens",
      "category": "interpretive",
      "description": "Evaluates risk patterns, escalation indicators, and threat assessment across evidence.",
      "priority": 95,
      "activation_rules": {
        "domains": [
          "domestic_violence",
          "dv",
          "custody",
          "custody_dispute",
          "elder_abuse",
          "elderabuse",
          "workplace",
          "employment",
          "stalking_harassment",
          "sexual_assault",
          "coercive_control",
          "child_abuse",
          "wrongful_termination"
        ],
        "evidence_signals": [
          "threat",
          "injury",
          "stalking"
        ]
      },
      "signal_threshold": 1,
      "confidence_weights": {
        "threat": 1.5,
        "injury": 1.2,
        "stalking": 1.0
      },
      "supports": [
        "trauma_informed",
        "coercive_control_lens"
      ],
      "metadata_fields": [
        "risk_level",
        "risk_factors",
        "vulnerable_parties",
        "escalation_indicators"
      ],
      "analysis_hooks": [
        "escalation_pattern",
        "threat_assessment",
        "vulnerability_scoring"
      ],
      "ui_surfaces": [
        "safety_indicators",
        "case_overview_card",
        "findings_filter"
      ]
    },
    {
      "lens_id": "coercive_control_lens",
      "label": "Coercive Control Lens",
      "category": "interpretive",
      "description": "Identifies patterns of domination through isolation, financial control, surveillance, and psychological manipulation.",
      "priority": 93,
      "activation_rules": {
        "domains": [
          "domestic_violence",
          "dv",
