{
  "version": "2.0.0",
  "structural_lenses": [
    {
      "lens_id": "evidence",
      "label": "Evidence Lens",
      "category": "structural",
      "description": "Extracts entities, claims, quotes, and relationships from documents.",
      "priority": 100,
      "activation_rules": {
        "always": true
      },
      "metadata_fields": [
        "entity_count",
        "claim_count",
        "quote_count",
        "relationship_count"
      ],
      "analysis_hooks": [
        "entity_extraction",
        "claim_classification",
        "quote_anchoring"
      ],
      "ui_surfaces": [
        "case_overview_card",
        "documents_panel",
        "entity_list"
      ]
    },
    {
      "lens_id": "timeline",
      "label": "Timeline Lens",
      "category": "structural",
      "description": "Normalizes events into chronological sequence and detects temporal gaps.",
      "priority": 100,
      "activation_rules": {
        "always": true
      },
      "metadata_fields": [
        "event_count",
        "date_range_start",
        "date_range_end",
        "temporal_gaps"
      ],
      "analysis_hooks": [
        "event_normalization",
        "gap_detection",
        "chronological_ordering"
      ],
      "ui_surfaces": [
        "timeline_panel",
        "case_overview_card"
      ]
    },
    {
      "lens_id": "network",
      "label": "Network Lens",
      "category": "structural",
      "description": "Maps relationships between entities and detects network clusters.",
      "priority": 100,
      "activation_rules": {
        "always": true
      },
      "metadata_fields": [
        "node_count",
        "edge_count",
        "cluster_count"
      ],
      "analysis_hooks": [
        "relationship_mapping",
        "cluster_detection",
        "centrality_analysis"
      ],
      "ui_surfaces": [
        "network_graph",
        "case_overview_card"
      ]
    },
    {
      "lens_id": "provenance",
      "label": "Provenance Lens",
      "category": "structural",
      "description": "Tracks document origin, source attribution, and evidentiary chain.",
      "priority": 100,
      "activation_rules": {
        "always": true
      },
      "metadata_fields": [
        "source_types",
        "statement_origins",
        "provenance_coverage"
      ],
      "analysis_hooks": [
        "source_attribution",
        "origin_labeling",
        "chain_validation"
      ],
      "ui_surfaces": [
        "provenance_panel",
        "document_detail"
      ]
    }
  ],
