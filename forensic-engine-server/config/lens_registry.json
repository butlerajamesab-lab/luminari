    {
      "lens_id": "mental_health",
      "label": "Mental Health System Lens",
      "description": "Activates forensic analysis patterns specific to psychiatric care settings: involuntary holds, medication management, restraint protocols, discharge planning, patient rights, and family access. Leads with belief in the person's experience, not clinical assumptions.",
      "focus_areas": [
        "involuntary_hold_legality",
        "medication_safety_and_interactions",
        "restraint_seclusion_compliance",
        "discharge_planning_adequacy",
        "patient_rights_compliance",
        "family_access_and_communication",
        "informed_consent_verification",
        "records_accuracy_and_completeness"
      ],
      "signal_amplifiers": [
        "missing_physician_order",
        "hold_exceeds_statutory_duration",
        "no_hearing_conducted",
        "concurrent_medications_flagged",
        "no_discharge_plan",
        "family_communication_blocked",
        "restraint_without_documentation",
        "records_access_denied"
      ],
      "category": "domain",
      "priority": 90,
      "activation_rules": {
        "domains": [
          "mental_health",
          "psychiatric",
          "involuntary_hold",
          "psych_hold",
          "medication_harm",
          "restraint",
          "seclusion"
        ]
      },
      "metadata_fields": [
        "hold_type",
        "hold_duration",
        "medication_count",
        "restraint_incidents",
        "discharge_plan_status",
        "patient_rights_violations",
        "family_access_barriers"
      ],
      "analysis_hooks": [
        "hold_legality_check",
        "polypharmacy_risk_assessment",
        "restraint_compliance_review",
        "discharge_adequacy_evaluation",
        "patient_rights_audit"
      ],
      "ui_surfaces": [
        "domain_summary_card",
        "medication_timeline",
        "hold_legality_indicators",
        "findings_filter"
      ]
